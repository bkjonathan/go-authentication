GIN_MODE=debug
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=go_auth
DB_SSLMODE=disable

# Auth
JWT_SECRET=replace_this_before_running_anywhere_real
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=720h
BCRYPT_COST=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
